    .feature-card h4 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 10px; }
    .feature-card p { font-size: 0.88rem; color: var(--mid-text); line-height: 1.75; margin: 0; }
 
    /* SWOT */
    .swot-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 20px; }
