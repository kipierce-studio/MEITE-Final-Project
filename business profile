    .sd-outcomes { display: flex; flex-wrap: wrap; gap: 10px; }
    .sd-outcome {
      background: var(--offwhite); border: 2px solid var(--teal);
      border-radius: 50px; padding: 8px 16px;
      font-size: 0.85rem; font-weight: 600; color: var(--navy);
    }
    .research-cite {
      background: var(--offwhite); border-radius: var(--radius-sm);
      padding: 16px 20px; font-size: 0.84rem; color: var(--mid-text);
      line-height: 1.65; border-left: 3px solid var(--teal);
    }
 
    @media (max-width: 900px) {
      .profile-banner { grid-template-columns: 1fr; }
      .features-grid { grid-template-columns: 1fr; }
      .swot-grid { grid-template-columns: 1fr; }
