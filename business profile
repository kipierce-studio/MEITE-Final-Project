    .swot-t { background: #fce4ec; } .swot-t .swot-badge { background: #c62828; color: #fff; }
    .swot-list { list-style: none; }
    .swot-list li {
      font-size: 0.87rem; color: var(--dark-text); padding: 7px 0 7px 18px;
      position: relative; border-bottom: 1px solid rgba(0,0,0,0.06); line-height: 1.6;
