    .swot-list li::before { content:'→'; position:absolute; left:0; color:var(--gold); font-size:0.8rem; }
    .swot-list li:last-child { border-bottom: none; }
 
    /* Competitors */
    .competitor-wrap { overflow-x: auto; border-radius: var(--radius); box-shadow: var(--shadow); }
